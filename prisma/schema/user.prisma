enum Role {
    CUSTOMER
    ADMIN

    @@map("user_role")
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    password  String
    role      Role     @default(CUSTOMER)
    createAt  DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("users")
}
